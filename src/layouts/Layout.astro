---
import HeaderNav from '../components/HeaderNav.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Shale</title>
    <meta name="description" content="Shale — an atmospheric puzzle-adventure set in caverns and abandoned laboratories." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Merriweather:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <!-- Open Graph / Social -->
    <meta property="og:title" content="Shale" />
    <meta property="og:description" content="Explore abandoned caverns and secret laboratories in this atmospheric puzzle-adventure." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/social-preview.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('a').forEach(link => {
          const isExternal = link.hostname && link.hostname !== window.location.hostname;
          if (isExternal) {
            link.addEventListener('click', () => {
              umami.track('Outbound Link', { url: link.href, text: link.innerText.trim() });
            });
          }
        });
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <HeaderNav />
    <slot />
  </body>
</html>

  <style is:global>
  :root {
    --bg: #0b0c10;
    --text: #e6eef2;
    --muted: #94a3b8;
    --accent: #f2386d;
    --accent2: #ff7b50;
    --accent-muted: color-mix(in srgb, var(--accent) 36%, var(--muted) 64%);
    --card: rgba(255,255,255,0.03);
  }

  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    background: var(--bg);
    color: var(--text);
    font-family: "Merriweather", Georgia, "Times New Roman", serif;
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 10px;
  }
  ::-webkit-scrollbar-track {
    background: var(--bg);
  }
  ::-webkit-scrollbar-thumb {
    background: #1f2937;
    border-radius: 5px;
    border: 2px solid var(--bg);
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--accent);
  }

  a { color: var(--accent); }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    text-decoration: none;
    font-weight: 600;
    border: 1px solid transparent;
    transition: transform 160ms ease, box-shadow 160ms ease;
    font-family: "Space Grotesk", "Inter", "Segoe UI", sans-serif;
    white-space: nowrap;
    cursor: pointer;
  }

  .button.primary {
    background: white;
    color: #030709;
  }

  .button.ghost {
    color: #f4f7ff;
    background: transparent;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  /* Skip link styles: hidden until focused */
  .skip-link {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
    background: #fff;
    color: #000;
    padding: 8px 12px;
    z-index: 1000;
    border-radius: 4px;
    text-decoration: none;
  }

  .skip-link:focus {
    left: 12px;
    top: 12px;
    width: auto;
    height: auto;
    overflow: visible;
  }
</style>
